// Use DBML to define your database structure
// Fleetwood Mac Website - Complete Schema
// Docs: https://dbml.dbdl.io/docs

Table albums {
  id varchar [primary key]
  title varchar
  year integer
  sales integer
  streams integer
  desc text
  era varchar
  cert varchar
  image varchar
}

Table songs {
  id integer [primary key]
  title varchar
  album_id varchar
  writer_id integer
  year integer
  streams integer
  rank integer
}

Table writers {
  id integer [primary key]
  name varchar
}

Table band_members {
  id integer [primary key]
  writer_id integer
  name varchar
  role varchar
  instrument varchar
  before_fm text
}

Table concerts {
  id integer [primary key]
  date varchar
  venue varchar
  location varchar
  tour varchar
  band varchar
  attendance varchar
  era varchar
  type varchar
}

Table users {
  email varchar [primary key]
  password varchar
}

Table subscribers {
  email varchar [primary key]
}

Ref: albums.id > songs.album_id
Ref: writers.id > songs.writer_id
Ref: band_members.writer_id - writers.id

